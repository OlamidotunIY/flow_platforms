{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@flow/ui/*": ["./src/*"],
      "@workspace/ui/components": ["./src/components"],
      "@workspace/ui/components/*": ["./src/components/*"],
      "@workspace/ui/hooks": ["./src/hooks"],
      "@workspace/ui/hooks/*": ["./src/hooks/*"],
      "@workspace/ui/lib": ["./src/lib"],
      "@workspace/ui/lib/*": ["./src/lib/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
