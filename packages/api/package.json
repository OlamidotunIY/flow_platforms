{
  "name": "@flow/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "pnpm codegen:watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "codegen": "openapi-ts --file openapi-ts.config.ts",
    "codegen:watch": "openapi-ts --file openapi-ts.config.ts --watch"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.2",
    "@types/node": "25.1.0"
  },
  "dependencies": {
    "better-auth": "1.6.11",
    "socket.io-client": "^4.8.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./client": "./src/client.ts",
    "./generated": "./src/generated/index.ts",
    "./sdk": "./src/generated/sdk.gen.ts",
    "./socket": "./src/socket.ts",
    "./types": "./src/generated/types.gen.ts"
  }
}
